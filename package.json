{
  "type": "module",
  "version": "4.3.2",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "AGPL-3.0-only",
  "name": "@stakewise/v3-sdk",
  "typings": "dist/index.d.ts",
  "module": "dist/index.esm.js",
  "description": "StakeWise v3 SDK",
  "homepage": "https://github.com/stakewise/v3-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stakewise/v3-sdk.git"
  },
  "scripts": {
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:fork": "vitest run --project fork",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "prepare": "husky && pnpm typechain && pnpm graphql",
    "build": "pnpm prepare && pnpm test && rm -rf ./dist && pnpm rollup",
    "typechain:vault": "typechain --target ethers-v6 --out-dir src/contracts/vault/types 'src/contracts/vault/abis/*.json'",
    "typechain:base": "typechain --target ethers-v6 --out-dir src/contracts/types 'src/contracts/abis/*.json'",
    "typechain": "pnpm typechain:base && pnpm typechain:vault",
    "graphql": "graphql-codegen && tsx ./scripts/generateGraphqlExports/index.ts",
    "rollup": "rollup --config rollup.config.js",
    "check:docLinks": "node ./scripts/checkDocLinks.js",
    "check:forkAddresses": "tsx ./scripts/checkForkAddresses.ts",
    "lint": "eslint ./src ./test vitest.config.ts --ext .ts,.tsx,.js,.jsx",
    "release": "pnpm build && pnpm publish --tag=latest",
    "sync:docs": "tsx ./scripts/syncDocs/index.ts"
  },
  "files": [
    "dist/",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.esm.js"
    },
    "./index.js": "./dist/index.js",
    "./index.js.map": "./dist/index.js.map",
    "./index.esm.js": "./dist/index.esm.js",
    "./index.esm.js.map": "./dist/index.esm.js.map",
    "./package.json": "./package.json"
  },
  "keywords": [
    "stakewise",
    "ethereum",
    "staking"
  ],
  "peerDependencies": {
    "ethers": "^6.14.3"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@graphql-codegen/cli": "5.0.6",
    "@graphql-codegen/near-operation-file-preset": "3.0.1",
    "@graphql-codegen/typescript": "4.1.6",
    "@graphql-codegen/typescript-operations": "4.6.1",
    "@octokit/rest": "22.0.0",
    "@rollup/plugin-commonjs": "26.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.1.2",
    "@typechain/ethers-v6": "0.5.1",
    "@types/fs-extra": "11.0.4",
    "@types/rollup-plugin-peer-deps-external": "2.2.5",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "9.27.0",
    "eslint-import-resolver-typescript": "4.4.2",
    "eslint-plugin-import": "2.31.0",
    "fs-extra": "11.3.2",
    "glob": "11.0.3",
    "globals": "16.2.0",
    "husky": "9.1.7",
    "rollup": "4.41.1",
    "rollup-plugin-delete": "3.0.1",
    "rollup-plugin-dts": "6.2.1",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "simple-git": "3.28.0",
    "tsx": "4.19.4",
    "typechain": "8.3.2",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "bignumber.js": "9.3.0",
    "zod": "4.4.3"
  }
}
